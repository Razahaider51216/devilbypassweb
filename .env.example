# Self-hosted database, sessions and uploads
# Local development: ./data
# Render with a persistent disk mounted at /var/data: /var/data
DATA_DIR=./data
# Neon PostgreSQL (recommended for Render Free). Leave empty for local SQLite.
DATABASE_URL=
SESSION_SECRET=replace-with-at-least-32-random-characters

# Discord OAuth login
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Production public origin, for example https://example.com
PUBLIC_SITE_URL=
# Must match a Redirect URI in Discord Developer Portal after resolving against the site origin.
DISCORD_REDIRECT_URI=/auth/discord/callback

# Discord user ID that always receives owner/admin access
OWNER_DISCORD_ID=

# Bypass provider (server-only)
IXCORE_API_KEY=

# PromptPay / SlipOK (optional)
VITE_PROMPTPAY_NUMBER=
PROMPTPAY_NUMBER=
VITE_SLIPOK_API_URL=
SLIPOK_API_KEY=
SLIPOK_BRANCH_ID=
